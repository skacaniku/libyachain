# LibyaChain Blockchain Node Dockerfile
# Multi-stage build for optimized image size

# Stage 1: Build
FROM golang:1.25.1-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    git \
    make \
    gcc \
    musl-dev \
    linux-headers \
    ca-certificates

# Set working directory
WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the binary
RUN make build

# Stage 2: Runtime
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    bash \
    jq \
    curl

# Create non-root user
RUN addgroup -g 1000 libya && \
    adduser -D -u 1000 -G libya libya

# Copy binary from builder
COPY --from=builder /build/build/libyachaind /usr/local/bin/libyachaind

# Copy initialization scripts
COPY --from=builder /build/scripts /scripts

# Set ownership
RUN chown -R libya:libya /usr/local/bin/libyachaind && \
    chmod +x /usr/local/bin/libyachaind

# Create data directory
RUN mkdir -p /home/libya/.libyachain && \
    chown -R libya:libya /home/libya/.libyachain

# Switch to non-root user
USER libya
WORKDIR /home/libya

# Expose ports
EXPOSE 26656 26657 26660 1317 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD libyachaind status 2>&1 | jq -e '.SyncInfo.catching_up == false' || exit 1

# Default command
CMD ["libyachaind", "start"]
